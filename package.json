{
  "name": "kwanza-news-server",
  "private": true,
  "version": "1.0.0",
  "description": "API editorial do portal Kwanza News",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-db.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/lib/image-file.test.ts src/lib/search-text.test.ts src/lib/archive-range.test.ts src/lib/consent-rules.test.ts",
    "pack:release": "powershell -ExecutionPolicy Bypass -File ./scripts/pack-release.ps1"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "geoip-lite": "^2.0.3",
    "ioredis": "^6.0.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/sharp": "^0.31.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
